---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string;
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords = 'zen, mindfulness, intelligenza artificiale, meditazione, Lucia S., Essere Zen, lucidità, pensiero prefabbricato'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImage = new URL(image, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Lucia S." />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={fullImage} />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content="Essere Zen" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImage} />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Essere Zen" href="/rss.xml" />

  <script defer src="/_vercel/insights/script.js"></script>

  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <header class="border-b border-gray-200/50 bg-cream/95 backdrop-blur sticky top-0 z-50">
    <nav class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
      <a href="/" class="font-serif text-xl font-semibold text-ink hover:text-cobalt transition-colors">
        Essere Zen
      </a>
      <ul class="flex items-center gap-6 text-sm font-medium">
        <li><a href="/" class="hover:text-cobalt transition-colors">Home</a></li>
        <li><a href="/libro" class="hover:text-cobalt transition-colors">Il libro</a></li>
        <li><a href="/blog" class="hover:text-cobalt transition-colors">Blog</a></li>
        <li><a href="/chi-sono" class="hover:text-cobalt transition-colors">Chi sono</a></li>
      </ul>
    </nav>
  </header>
  
  <main class="flex-1">
    <slot />
  </main>
  
  <footer class="border-t border-gray-200/50 py-12 mt-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-8 mb-8">
        <div>
          <h3 class="font-serif text-lg font-semibold mb-3">Essere Zen</h3>
          <p class="text-sm text-ink-soft leading-relaxed">
            Una pratica zen sobria per restare lucidi in un mondo che accelera per noi.
          </p>
        </div>
        <div>
          <h3 class="font-serif text-lg font-semibold mb-3">Il libro</h3>
          <p class="text-sm text-ink-soft mb-2">
            <em>Zen ai tempi dell'AI</em><br/>
            di Lucia S.
          </p>
          <a href="https://www.amazon.it/dp/B0H3KBQL9P" target="_blank" rel="noopener noreferrer" 
             class="text-sm text-cobalt hover:underline">
            → Acquista su Amazon
          </a>
        </div>
        <div>
          <h3 class="font-serif text-lg font-semibold mb-3">Seguimi</h3>
          <ul class="text-sm space-y-1.5">
            <li><a href="https://youtube.com/@ESSEREZEN" target="_blank" rel="noopener noreferrer" class="text-cobalt hover:underline">YouTube</a></li>
            <li><a href="#" class="text-cobalt hover:underline">Instagram</a></li>
            <li><a href="#" class="text-cobalt hover:underline">TikTok</a></li>
          </ul>
        </div>
      </div>
      <div class="pt-8 border-t border-gray-200/50 text-xs text-muted text-center">
        © 2026 Lucia S. — Tutti i diritti riservati
      </div>
    </div>
  </footer>
</body>
</html>
